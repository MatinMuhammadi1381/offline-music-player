{
  "name": "offline-music-player",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test packages/music-core/test/music-core.test.ts packages/web-platform/test/web-platform.test.ts",
    "typecheck": "npm exec --yes --package=https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz -- tsc --noEmit -p tsconfig.json",
    "typecheck:web": "pnpm --filter @offline-music-player/player-web typecheck",
    "build:web": "pnpm --filter @offline-music-player/player-web build",
    "dev:web": "pnpm --filter @offline-music-player/player-web dev",
    "package:development": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-development-handoff.ps1"
  }
}
